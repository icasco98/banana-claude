# Copy to .env for local testing, or set these as environment variables
# in your hosting platform (e.g. Render's Environment tab).

# Required. Get a free key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Optional but strongly recommended. When set, the MCP endpoint is served
# at /<token>/mcp instead of /mcp, so the connection URL itself acts as a
# shared secret and random internet traffic can't spend your Gemini quota.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MCP_ACCESS_TOKEN=

# Optional. Render sets PORT automatically; only needed for local runs.
PORT=8000
